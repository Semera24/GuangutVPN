{
  "manifest_version": 3,
  "name": "GuangutVPN — Secure US & Global Proxy VPN",
  "version": "1.0.0",
  "description": "Free, open-source browser VPN extension with US Regional (East/Central/West/State) and Global proxy routing.",
  "permissions": [
    "proxy",
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://ipwho.is/*",
    "https://ipinfo.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GuangutVPN Control"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
